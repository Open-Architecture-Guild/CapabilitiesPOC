{
  "name": "opencap",
  "version": "0.1.0",
  "description": "Open, community-driven capability map for architects, with a searchable website",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "validate": "node tools/validate.mjs",
    "build": "node tools/build-site.mjs",
    "serve": "node tools/serve.mjs",
    "dev": "npm run build && npm run serve",
    "test": "node --test \"tools/**/*.test.mjs\"",
    "build:standalone": "npm run build && node tools/build-standalone.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "ajv": "^8.20.0",
    "minisearch": "^7.2.0",
    "yaml": "^2.9.1"
  }
}
